# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service_role key. SERVER ONLY: used by /api routes to approve posts and
# post check-ins. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic API, or an Anthropic-compatible provider (e.g. apiyi). SERVER ONLY. ---
ANTHROPIC_API_KEY=
# Required: the model name for all AI features, exactly as your provider lists it.
ANTHROPIC_MODEL=
# Optional: provider base URL, e.g. https://api.apiyi.com. Empty = Anthropic's own API.
ANTHROPIC_BASE_URL=
# Optional: comma-separated models to fall back to if the main model declines.
# Only these models are ever used. Empty = fallback OFF.
ANTHROPIC_FALLBACK_MODELS=
# Optional: caption timeout in ms (default 5000).
CAPTION_TIMEOUT_MS=

# --- Testing ---
# Any long random string. Lets `npm run redteam` call /api/moderate and /api/caption directly.
REDTEAM_TOKEN=
# Local development only: approve posts without calling the AI (ignored in production).
MODERATION_DEV_ALLOW_ALL=
