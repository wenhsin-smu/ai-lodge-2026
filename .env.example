# Copy to .env.local for local development. On Vercel, set the same variables in
# Project Settings -> Environment Variables (Vercel does not read .env.local).

# --- Supabase (Project Settings -> API Keys) ---
# Project URL. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (Alternative name accepted instead of the line above: the legacy anon key.)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service_role key. SERVER ONLY: used by /api routes to approve posts,
# post check-ins and compute weekly stats. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# (Alternative name accepted instead of the line above: the new sb_secret_... key.)
# SUPABASE_SECRET_KEY=

# --- Anthropic API, or an Anthropic-compatible provider (e.g. apiyi). SERVER ONLY. ---
ANTHROPIC_API_KEY=
# Required: the model name for all AI features, exactly as your provider lists it.
ANTHROPIC_MODEL=
# Optional: provider base URL, e.g. https://api.apiyi.com. Empty = Anthropic's own API.
ANTHROPIC_BASE_URL=
# Optional: comma-separated models to fall back to if the main model declines.
# Only these models are ever used. Empty = fallback OFF.
ANTHROPIC_FALLBACK_MODELS=
# Optional: caption timeout in ms (default 5000).
CAPTION_TIMEOUT_MS=

# --- Testing ---
# Optional: any long random string. Lets `npm run redteam` and `npm run ai:check`
# call the AI routes directly. Leave empty on the live site unless you need it.
REDTEAM_TOKEN=
# Local development only: approve posts without calling the AI (ignored in production).
MODERATION_DEV_ALLOW_ALL=
# Scripts only (not read by the app):
# BASE_URL=http://localhost:3000    # where `npm run redteam` / `npm run ai:check` send requests
# CHROMIUM_PATH=                    # browser used by redteam/make-images.mjs to draw test images
